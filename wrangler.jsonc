{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-pixel-grid",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "alias": {
    "ai": "./src/stubs/ai.ts"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GridRoom" },
      { "name": "MCP", "class_name": "GridMCP" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GridRoom", "GridMCP"]
    }
  ],
  "observability": { "enabled": true }
}
